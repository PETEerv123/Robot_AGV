<?xml version="1.0"?>
<robot name="robot_agv">

  <!-- ================= Materials ================= -->

  <material name="red">
    <color rgba="1 0 0 0.7"/>
  </material>

  <material name="blue">
    <color rgba="0 0 0.6 1"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 0.7"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <!-- ================= Links ================= -->

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.52 0.55 0.08"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- ================= Wheels ================= -->

  <link name="Front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="Front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="Back_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="Back_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- ================= Joints ================= -->

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>
  <!-- LiDAR -->
  <joint name="base_laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 -0.02 0.105" rpy="0 0 3.1415"/>

  </joint>

  <!-- Front Left -->
  <joint name="base_Fleft_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="Front_left_wheel"/>
    <origin xyz="0.275 0.260 0.025" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Right -->
  <joint name="base_Fright_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="Front_right_wheel"/>
    <origin xyz="0.275 -0.260 0.025" rpy="1.5708 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <!-- Back Left -->
  <joint name="base_Bleft_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="Back_left_wheel"/>
    <origin xyz="-0.275 -0.260 0.025" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Back Right -->
  <joint name="base_Bright_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="Back_right_wheel"/>
    <origin xyz="-0.275 0.260 0.025" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
